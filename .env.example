# Proveedor LLM: anthropic | openai | mock
# "openai" sirve para cualquier API compatible con Chat Completions
# (OpenAI, Gemini en modo compatible, Groq, OpenRouter, Ollama...).
# "mock" no necesita clave: modelo guionado para probar el ciclo y el front.
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- OpenAI-compatible ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# --- Límites (protegen tu clave) ---
PORT=3000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
MAX_TOKENS_DIA=1500000
LLM_TIMEOUT_MS=60000
RATE_LIMIT_POR_MINUTO=20
